[Unit]
Description=Torizon Remote Access Client
After=network-online.target nss-lookup.target boot-complete.target tzn-mqtt.service
Requires=boot-complete.target
Wants=network-online.target tzn-mqtt.service
ConditionPathExists=|/var/sota/import/pkey.pem

[Service]
RestartSec=10
Restart=always
Environment="CONFIG_FILE=/etc/rac/client.toml"
# rac is started as root so it can read the device TLS key, then it drops
# privileges to the rac user (unprivileged_user_group in client.toml).
# migrate-rac-state.sh creates/migrates @@RUNRAC_FOLDER@@ and ensures it (and
# any pre-existing state in it) is owned by rac, see TOR-4693.
ExecStartPre=/usr/libexec/rac/migrate-rac-state.sh
ExecStart=/usr/bin/rac

[Install]
WantedBy=multi-user.target

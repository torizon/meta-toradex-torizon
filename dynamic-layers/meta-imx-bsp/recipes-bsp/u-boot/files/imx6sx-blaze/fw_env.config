# U-Boot counts back from the end of the partition (CONFIG_ENV_OFFSET
# 0xFFFFDE00 = -0x2200, CONFIG_ENV_OFFSET_REDUND = -0x4200); libubootenv only
# seeks SEEK_SET, so the offsets are absolute against boot0's 4 MiB. An eMMC
# with a boot partition of another size needs them recomputed.
#
# Uboot env device	Device offset	Env. size
/dev/mmcblk0boot0	0x3FDE00	0x2000
/dev/mmcblk0boot0	0x3FBE00	0x2000

SUBSYSTEM=="pwm", ACTION=="add", RUN+="/bin/chgrp pwm '/sys%p/export'", RUN+="/bin/chmod g=u '/sys%p/export'"
SUBSYSTEM=="pwm", ACTION=="add", RUN+="/bin/chgrp pwm '/sys%p/unexport'", RUN+="/bin/chmod g=u '/sys%p/unexport'"
SUBSYSTEM=="pwm", ACTION=="change", ENV{EXPORT}=="pwm[0-9]*", RUN+="/bin/chgrp pwm '/sys%p/$env{EXPORT}/duty_cycle'", RUN+="/bin/chmod g=u '/sys%p/$env{EXPORT}/duty_cycle'"
SUBSYSTEM=="pwm", ACTION=="change", ENV{EXPORT}=="pwm[0-9]*", RUN+="/bin/chgrp pwm '/sys%p/$env{EXPORT}/enable'", RUN+="/bin/chmod g=u '/sys%p/$env{EXPORT}/enable'"
SUBSYSTEM=="pwm", ACTION=="change", ENV{EXPORT}=="pwm[0-9]*", RUN+="/bin/chgrp pwm '/sys%p/$env{EXPORT}/period'", RUN+="/bin/chmod g=u '/sys%p/$env{EXPORT}/period'"
SUBSYSTEM=="pwm", ACTION=="change", ENV{EXPORT}=="pwm[0-9]*", RUN+="/bin/chgrp pwm '/sys%p/$env{EXPORT}/polarity'", RUN+="/bin/chmod g=u '/sys%p/$env{EXPORT}/polarity'"

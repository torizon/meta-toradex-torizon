From 786c4147822f5a4fa6158b266872aee24b2b11a6 Mon Sep 17 00:00:00 2001
From: Eduardo Ferreira <eduardo.barbosa@toradex.com>
Date: Wed, 7 Oct 2026 13:55:19 -0300
Subject: [PATCH] avio: dhub: ratelimit the spurious interrupt message

VPP raises unhandled dhub interrupts at up to ~180/s. Printing each
one from IRQ context floods the serial console and stalls CPU0 (RCU
stalls).

Upstream-Status: Pending
Signed-off-by: Eduardo Ferreira <eduardo.barbosa@toradex.com>
---
 soc/berlin/modules/avio/dhub/drv_dhub.c | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/soc/berlin/modules/avio/dhub/drv_dhub.c b/soc/berlin/modules/avio/dhub/drv_dhub.c
index dc062b8..b970727 100644
--- a/soc/berlin/modules/avio/dhub/drv_dhub.c
+++ b/soc/berlin/modules/avio/dhub/drv_dhub.c
@@ -214,7 +214,8 @@ static irqreturn_t avio_devices_dhub_isr(int irq, void *dev_id)
 			p_int_handler->pIntrHandler(intr_status,
 				p_int_handler->pIntrHandlerArgs);
 		else
-			avio_error("%s:%d: Spurious interrupt - %d/%x/%x\n",
+			printk_ratelimited(KERN_ERR AVIO_DEVICE_TAG
+				"%s:%d: Spurious interrupt - %d/%x/%x\n",
 				__func__, __LINE__, intr_num,
 				intr_status, p_int_handler->intrMask);
 
-- 
